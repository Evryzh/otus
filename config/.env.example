# =============================================================
# OTUS Users — переменные окружения
# =============================================================
# Скопируйте этот файл в корень проекта как .env и подставьте
# реальные значения. Файл .env не должен попадать в git.
#
# Для локальной разработки — значения по умолчанию из Docker Compose.
# Для Kubernetes — берутся из ConfigMap и Secret.
#
# Все переменные опциональны и имеют дефолты в application.yaml.
# Раскомментируйте и переопределите только те, которые нужно изменить.
# =============================================================

# -------------------------------------------------------------
# PostgreSQL (обязательные для подключения)
# -------------------------------------------------------------
# В K8s: SPRING_DATASOURCE_URL берётся из ConfigMap,
#        SPRING_DATASOURCE_PASSWORD — из Secret.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/otus
SPRING_DATASOURCE_USERNAME=otus
SPRING_DATASOURCE_PASSWORD=otus

# -------------------------------------------------------------
# Keycloak (OAuth2 Resource Server)
# -------------------------------------------------------------
# Базовый URL Keycloak, realm и client.
# В K8s: KEYCLOAK_BASE_URL = http://keycloak.homework/auth
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI подхватится
# автоматически через relaxed binding, но можно задать явно.
# KEYCLOAK_BASE_URL=http://localhost:8080
# KEYCLOAK_REALM=otus
# KEYCLOAK_CLIENT_ID=otus-users

# Явное переопределение OIDC endpoints (если нужно).
# По умолчанию формируются из KEYCLOAK_BASE_URL и KEYCLOAK_REALM.
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8080/realms/otus
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://localhost:8080/realms/otus/protocol/openid-connect/certs

# -------------------------------------------------------------
# Keycloak Admin API (для создания пользователей)
# -------------------------------------------------------------
# Нужны для POST /api/v1/profile — приложение создаёт пользователя
# в Keycloak через Admin API.
# В K8s: KEYCLOAK_ADMIN_USERNAME — ConfigMap, KEYCLOAK_ADMIN_PASSWORD — Secret.
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# -------------------------------------------------------------
# Приложение
# -------------------------------------------------------------
# Порт, на котором слушает приложение (по умолчанию 8000).
# SERVER_PORT=8000

# Уровень логирования: TRACE, DEBUG, INFO, WARN, ERROR.
# LOG_LEVEL=INFO

# -------------------------------------------------------------
# Flyway (миграции БД)
# -------------------------------------------------------------
# true  — миграции применяются при старте приложения (локально, dev)
# false — миграции выполняются отдельным Job'ом (K8s)
# FLYWAY_ENABLED=true

# -------------------------------------------------------------
# Swagger / OpenAPI
# -------------------------------------------------------------
# По умолчанию Swagger выключен (безопасный дефолт для prod).
# Включите локально, если нужен доступ к Swagger UI.
# SPRINGDOC_SWAGGER_UI_ENABLED=true
# SPRINGDOC_API_DOCS_ENABLED=true

# -------------------------------------------------------------
# Профиль Spring (не задавайте без необходимости)
# -------------------------------------------------------------
# migration — используется в K8s Job, запускает только Flyway.
# SPRING_PROFILES_ACTIVE=migration