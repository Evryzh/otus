# =============================================================
# OTUS Users — переменные окружения
# =============================================================
# Скопируйте этот файл в корень проекта как .env и подставьте
# реальные значения. Файл .env не должен попадать в git.
#
# Для локальной разработки — значения по умолчанию из Docker Compose.
# Для Kubernetes — берутся из ConfigMap и Secret.
# =============================================================

# -------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------
# Локально: localhost:5432 (Docker Compose)
# В K8s:    postgres-postgresql.otus.svc.cluster.local:5432
DB_URL=jdbc:postgresql://localhost:5432/otus
DB_USERNAME=otus
DB_PASSWORD=otus

# -------------------------------------------------------------
# Keycloak
# -------------------------------------------------------------
# Базовый URL Keycloak.
# Локально: http://localhost:8080
# В K8s:    http://keycloak.homework/auth
KEYCLOAK_URL=http://localhost:8080

# Realm, в котором живут пользователи приложения.
KEYCLOAK_REALM=otus

# Client ID, через который приложение получает токены.
KEYCLOAK_CLIENT_ID=otus-users

# -------------------------------------------------------------
# Keycloak Admin API
# -------------------------------------------------------------
# Учётные данные администратора Keycloak.
# Нужны для создания пользователей при POST /api/v1/profile.
# В K8s: хранятся в Secret.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# -------------------------------------------------------------
# Приложение
# -------------------------------------------------------------
# Порт, на котором слушает приложение.
SERVER_PORT=8000

# Уровень логирования (DEBUG для отладки, INFO для прода).
LOG_LEVEL=INFO

# -------------------------------------------------------------
# Flyway
# -------------------------------------------------------------
# Включить миграции при старте приложения.
# В K8s: миграции выполняются через Job, поэтому здесь false.
FLYWAY_ENABLED=true